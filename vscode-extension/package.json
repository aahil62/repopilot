{
  "name": "repopilot",
  "displayName": "RepoPilot",
  "description": "Private, history-aware code review on open models you run yourself.",
  "version": "2.0.0",
  "publisher": "repopilot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aahil62/repopilot"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "code review",
    "local llm",
    "ollama",
    "privacy",
    "git history"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repopilot.reviewWorking",
        "title": "Review Working Changes",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.reviewStaged",
        "title": "Review Staged Changes",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.blastRadius",
        "title": "Show Blast Radius for This File",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.ask",
        "title": "Ask About This Repository",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.edit",
        "title": "Edit with Verification",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.nightShift",
        "title": "Open Night Shift Report",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.pickModels",
        "title": "Pick Models",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.index",
        "title": "Update Repository Memory",
        "category": "RepoPilot"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "repopilot.edit",
          "group": "repopilot@1"
        },
        {
          "command": "repopilot.blastRadius",
          "group": "repopilot@2"
        }
      ],
      "scm/title": [
        {
          "command": "repopilot.reviewWorking",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "RepoPilot",
      "properties": {
        "repopilot.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7341",
          "description": "Address of the local RepoPilot service."
        },
        "repopilot.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Start `repopilot serve` automatically when the service is not running."
        },
        "repopilot.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show a blast-radius summary at the top of each file."
        },
        "repopilot.runChecks": {
          "type": "boolean",
          "default": true,
          "description": "Run the project's tests in a temporary copy during reviews."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "node test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
