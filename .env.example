# RepoPilot needs no API keys and no .env file. Every setting below is optional;
# export it (or put it in your shell profile) only to change the default.

# Where repository memory, reviews and night-shift reports are stored.
# REPOPILOT_HOME=~/.repopilot

# Local model runtimes to look for (Ollama, LM Studio, llama.cpp server).
# REPOPILOT_RUNTIME_URLS=["http://127.0.0.1:11434","http://127.0.0.1:1234/v1","http://127.0.0.1:8080/v1"]

# Address of `repopilot serve`. Keep it on 127.0.0.1: there is no authentication.
# REPOPILOT_HOST=127.0.0.1
# REPOPILOT_PORT=7341

# Indexing limits.
# REPOPILOT_HISTORY_MAX_COMMITS=5000
# REPOPILOT_MAX_FILE_KB=512

# How long the project's tests may run during a review (seconds).
# REPOPILOT_CHECK_TIMEOUT_S=300

# The only outbound call: import public PR review comments from api.github.com. Off by default.
# REPOPILOT_ALLOW_GITHUB_IMPORT=1
